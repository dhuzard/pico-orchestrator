{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelRuntimeConfiguration",
  "description": "User-owned model bindings, assessed ambiguity capacities, and backend overrides. This file cannot change routing predicates, route precedence, capacity-assignment logic, execution topology, permissions, or review requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "codex": {
          "$ref": "#/$defs/familyModels"
        },
        "claude": {
          "$ref": "#/$defs/familyModels"
        }
      }
    },
    "claude_code": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "model_ids": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          }
        },
        "minimum_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    }
  },
  "anyOf": [
    {"required": ["models"]},
    {"required": ["claude_code"]}
  ],
  "$defs": {
    "familyModels": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "light": {"$ref": "#/$defs/modelBinding"},
        "economy": {"$ref": "#/$defs/modelBinding"},
        "standard": {"$ref": "#/$defs/modelBinding"},
        "high": {"$ref": "#/$defs/modelBinding"},
        "max": {"$ref": "#/$defs/modelBinding"}
      }
    },
    "modelBinding": {
      "description": "Object bindings declare assessed ambiguity capacity. Legacy string bindings matching built-in models retain their built-in assessment; unfamiliar models are treated as capacity 0.",
      "oneOf": [
        {"$ref": "#/$defs/modelId"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "ambiguity_capacity"],
          "properties": {
            "model": {"$ref": "#/$defs/modelId"},
            "ambiguity_capacity": {"type": "integer", "minimum": 0, "maximum": 10}
          }
        }
      ]
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    }
  }
}
