# TEMPLATE ONLY — not installed automatically. Review all paths and credentials.
[Unit]
Description=PICO opt-in GitHub Issues dispatcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Must match User= in pico-garden.service: both open the 0600 dispatcher database.
User=pico
Environment=HOME=/home/pico
Environment=PATH=/home/pico/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/pico/pico-orchestrator
ExecStart=/usr/bin/python3 /home/pico/pico-orchestrator/tools/issue_dispatcher.py --config /home/pico/.config/pi-coding-orchestrator/dispatcher.json serve
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
